{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "vitest/globals"
    ]
  },
  "include": [
    "apps/cryptball/**/*.ts",
    "apps/cryptball-server/**/*.ts",
    "vite.cryptball.config.ts",
    "vitest.cryptball*.config.ts",
    "playwright.cryptball*.config.ts"
  ]
}
